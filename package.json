{
  "name": "yoho-cli",
  "version": "0.4.1",
  "private": true,
  "description": "Manage PageHush articles and install or update GitHub Agent Skills",
  "type": "module",
  "bin": {
    "yoho": "dist/cli.cjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "format": "prettier --write src tests scripts package.json tsconfig.json pnpm-workspace.yaml README.md",
    "format:check": "prettier --check src tests scripts package.json tsconfig.json pnpm-workspace.yaml README.md",
    "test": "pnpm build && node --test --test-concurrency=1 tests/*.test.mjs",
    "test:file": "pnpm build && node --test --test-concurrency=1",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "^24.19.2",
    "commander": "^15.0.0",
    "esbuild": "^0.28.2",
    "micromark": "4.0.3",
    "parse5": "7.3.0",
    "prettier": "^3.9.10",
    "remark-parse": "11.0.0",
    "string-width": "^8.3.0",
    "typescript": "^7.0.2",
    "unified": "11.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@11.25.0"
}
