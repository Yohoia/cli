{
  "name": "yoho-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Manage local Yoho blog articles from the terminal or an AI product",
  "type": "module",
  "bin": {
    "yoho": "dist/cli.cjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "pnpm build && node --test --test-concurrency=1 tests/*.test.mjs",
    "test:file": "pnpm build && node --test --test-concurrency=1",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "commander": "^15.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
